<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="rikka.shizuku.api" />

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:label="lvnderrOS"
        android:icon="@drawable/gojobattle"
        android:roundIcon="@drawable/gojobattle"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- App Preloader -->
        <service
            android:name=".PreloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- RenderThread Service -->
        <service
            android:name=".ThreadService"
            android:exported="false" />

        <!-- Game Detection Receiver -->
        <receiver
            android:name=".GameDetectedReceiver"
            android:enabled="true"
            android:exported="true">

            <intent-filter>
                <action android:name="com.lvnderr.os.GAME_DETECTED" />
            </intent-filter>

        </receiver>

        <!-- Shizuku Provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
