<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="rikka.shizuku.api" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    
    <!-- IZIN UNTUK FOREGROUND SERVICE (PRELOADER) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:label="lvnderrOS"
        android:icon="@drawable/gojobattle"
        android:roundIcon="@drawable/gojobattle"
        android:theme="@android:style/Theme.Material.NoActionBar">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- DAFTARKAN PRELOAD SERVICE DI SINI -->
        <service 
            android:name=".PreloadService" 
            android:foregroundServiceType="dataSync" 
            android:exported="false" />

        <!-- DAFTARKAN TOAST RECEIVER DI SINI -->
        <receiver 
            android:name=".ToastReceiver" 
            android:exported="true">
            <intent-filter>
                <!-- Action ini harus sama persis dengan yang ada di lvndThread.sh -->
                <action android:name="com.lvnderrOS.SHOW_TOAST" />
            </intent-filter>
        </receiver>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
